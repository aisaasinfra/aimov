# 复制为 .dev.vars（本地）；生产用 `wrangler secret put <NAME>` 写入
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_SECRET=
# Waffo Pancake（默认支付）
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Dodo Payments（可选）
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Stripe（可选；sk_test_ 或 rk_test_ 开头的 test Key，webhook 签名密钥 whsec_）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal.cn（与 Waffo 并列的积分包通道。订阅不走 PayPal。Webhook ID 在开发者后台，不要填字面量 WEBHOOK_ID）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# fal.ai 视频生成
FAL_KEY=
# yir.ai 视频网关（VIDEO_PROVIDER=yir 时必填）
YIR_API_KEY=
# NanoAPI 视频服务（VIDEO_PROVIDER=nanoapi 时必填；本地 mock 不需要）
NANOAPI_API_KEY=
# OpenGen 连接鉴权（后台切到 opengen 或 VIDEO_PROVIDER=opengen 时需要）。不是厂商 Key，厂商 Key 留在 OpenGen 主机。
OPENGEN_API_KEY=
# 图片审核（MODERATION_PROVIDER=openai 时必填）
OPENAI_API_KEY=
# Turnstile（vars.TURNSTILE_SITE_KEY 非空时必填）
TURNSTILE_SECRET_KEY=
# 付款即时通知（可选）：Telegram / 飞书 / Discord / Slack 的 webhook 地址，见 docs/env.md
PAYMENT_NOTIFY_WEBHOOK_URL=
# 可选错误上报（Sentry 兼容的 envelope）。留空 = 关闭，错误仍只进 Workers 日志。不要填内网或 IP 地址。
SENTRY_DSN=
# 人工履行 Google Sheet（fulfillmentMode=manual 时镜像队列。三个都要配。私钥是 PKCS8，换行写成 \n。不是厂商 Key）
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
